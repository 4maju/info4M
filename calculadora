
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora de Média Escolar</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #dbeafe, #eff6ff);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: white;
            width: 100%;
            max-width: 450px;
            padding: 35px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            color: #1e40af;
            margin-bottom: 10px;
        }

        .descricao {
            text-align: center;
            color: #666;
            margin-bottom: 25px;
            font-size: 14px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            color: #333;
            font-weight: bold;
        }

        input {
            width: 100%;
            padding: 12px;
            margin-bottom: 18px;
            border: 1px solid #ccc;
            border-radius: 7px;
            font-size: 15px;
            outline: none;
        }

        input:focus {
            border-color: #2563eb;
        }

        button {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 7px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 5px;
        }

        .calcular {
            background: #2563eb;
            color: white;
        }

        .calcular:hover {
            background: #1d4ed8;
        }

        .limpar {
            background: #e5e7eb;
            color: #333;
            margin-top: 10px;
        }

        .limpar:hover {
            background: #d1d5db;
        }

        .resultado {
            display: none;
            margin-top: 25px;
            padding: 18px;
            border-radius: 8px;
            text-align: center;
        }

        .resultado h2 {
            margin-bottom: 10px;
            font-size: 22px;
        }

        .resultado p {
            margin-bottom: 10px;
        }

        .resultado strong {
            font-size: 26px;
            display: block;
            margin: 12px 0;
        }

        .positivo {
            background: #dcfce7;
            color: #166534;
        }

        .negativo {
            background: #fee2e2;
            color: #991b1b;
        }

        .aviso {
            color: #dc2626;
            font-size: 13px;
            margin-bottom: 12px;
            display: none;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>Calculadora de Média</h1>

        <p class="descricao">
            Descubra quanto você precisa tirar no 4º bimestre para ser aprovado.
        </p>

        <form id="formulario">

            <label for="nome">Nome do aluno:</label>
            <input type="text" id="nome" placeholder="Digite seu nome">

            <label for="nota1">Nota do 1º bimestre:</label>
            <input type="number" id="nota1" placeholder="Digite a nota" min="0" max="10" step="0.1">

            <label for="nota2">Nota do 2º bimestre:</label>
            <input type="number" id="nota2" placeholder="Digite a nota" min="0" max="10" step="0.1">

            <label for="nota3">Nota do 3º bimestre:</label>
            <input type="number" id="nota3" placeholder="Digite a nota" min="0" max="10" step="0.1">

            <p class="aviso" id="aviso"></p>

            <button type="submit" class="calcular">
                Calcular nota necessária
            </button>

            <button type="button" class="limpar" onclick="limparCampos()">
                Limpar
            </button>

        </form>

        <div class="resultado" id="resultado">
            <h2 id="situacao"></h2>
            <p id="nomeResultado"></p>
            <p id="somaNotas"></p>
            <p id="mensagem"></p>
            <strong id="notaNecessaria"></strong>
        </div>

    </div>

    <script>
        const formulario = document.getElementById("formulario");

        formulario.addEventListener("submit", function(event) {
            event.preventDefault();

            const nome = document.getElementById("nome").value.trim();

            const nota1 = document.getElementById("nota1").value;
            const nota2 = document.getElementById("nota2").value;
            const nota3 = document.getElementById("nota3").value;

            const aviso = document.getElementById("aviso");
            const resultado = document.getElementById("resultado");

            aviso.style.display = "none";
            resultado.style.display = "none";

            if (nome === "" || nota1 === "" || nota2 === "" || nota3 === "") {
                aviso.textContent = "Preencha todos os campos.";
                aviso.style.display = "block";
                return;
            }

            const n1 = Number(nota1);
            const n2 = Number(nota2);
            const n3 = Number(nota3);

            if (
                !Number.isFinite(n1) ||
                !Number.isFinite(n2) ||
                !Number.isFinite(n3) ||
                n1 < 0 || n1 > 10 ||
                n2 < 0 || n2 > 10 ||
                n3 < 0 || n3 > 10
            ) {
                aviso.textContent = "Digite notas válidas entre 0 e 10.";
                aviso.style.display = "block";
                return;
            }

            const soma = n1 + n2 + n3;
            const notaNecessaria = 24 - soma;

            document.getElementById("nomeResultado").textContent =
                "Aluno: " + nome;

            document.getElementById("somaNotas").textContent =
                "Soma das três primeiras notas: " + soma.toFixed(1);

            const situacao = document.getElementById("situacao");
            const mensagem = document.getElementById("mensagem");
            const notaExibida = document.getElementById("notaNecessaria");

            if (notaNecessaria <= 0) {
                situacao.textContent = "MÉDIA ALCANÇADA!";
                mensagem.textContent =
                    "Você já alcançou a média anual mínima de 6,0.";
                notaExibida.textContent = "Você já atingiu a meta!";
                resultado.className = "resultado positivo";

            } else if (notaNecessaria <= 10) {
                situacao.textContent = "NOTA NECESSÁRIA";
                mensagem.textContent =
                    "Você precisa tirar no mínimo no 4º bimestre:";
                notaExibida.textContent =
                    notaNecessaria.toFixed(1);
                resultado.className = "resultado positivo";

            } else {
                situacao.textContent = "ATENÇÃO!";
                mensagem.textContent =
                    "Mesmo tirando 10 no 4º bimestre, você não alcançará a média 6,0.";
                notaExibida.textContent =
                    "Nota necessária: " + notaNecessaria.toFixed(1);
                resultado.className = "resultado negativo";
            }

            resultado.style.display = "block";
        });

        function limparCampos() {
            formulario.reset();

            document.getElementById("resultado").style.display = "none";
            document.getElementById("aviso").style.display = "none";
        }
    </script>

</body>
</html>
